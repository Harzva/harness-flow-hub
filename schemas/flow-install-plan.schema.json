{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-flow.dev/schemas/flow-install-plan.schema.json",
  "title": "Harness Flow Install Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "createdAt", "action", "profile", "flow", "stack", "operations", "risk", "steps", "executable", "blockers"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-f0-9]{24}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "action": { "const": "install-flow" },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "isolation", "template"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "isolation": { "const": "new" },
        "template": { "enum": ["headless", "web"] }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "variant", "digest"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" },
        "variant": { "enum": ["lite", "standard", "local", "safe"] },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "stack": { "$ref": "stack-lock.schema.json" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "action", "package", "version", "source", "verification", "lifecycleScripts", "permissions", "credentials"],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "action": { "const": "add" },
          "package": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "spec", "integrity"],
            "properties": {
              "kind": { "enum": ["npm", "tgz", "github-sha", "local-directory"] },
              "spec": { "type": "string", "minLength": 1 },
              "integrity": { "type": "string", "minLength": 1 },
              "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
            }
          },
          "verification": { "enum": ["unknown", "unverified", "passed", "failed", "stale"] },
          "lifecycleScripts": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "permissions": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "credentials": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } }
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registrySignature", "lifecycleScriptsDisabled", "permissionsPreset", "permissions", "credentials"],
      "properties": {
        "registrySignature": { "enum": ["verified", "unverified"] },
        "lifecycleScriptsDisabled": { "const": true },
        "permissionsPreset": { "type": "string", "minLength": 1 },
        "permissions": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "credentials": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 10,
      "items": { "enum": ["preflight", "initialize-profile", "snapshot", "staging", "install-packages", "dump-config", "boot-smoke", "commit", "health", "write-stack-lock"] }
    },
    "executable": { "type": "boolean" },
    "blockers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}

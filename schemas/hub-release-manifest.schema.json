{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-flow.dev/schemas/hub-release-manifest.schema.json",
  "title": "Harness Flow Hub Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageName", "version", "sourceDate", "compatibility", "artifact", "matrix", "releaseNotes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageName": { "const": "@harness-flow/dsh-flow-hub" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "sourceDate": { "type": "string", "format": "date" },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dsh", "registrySchema", "flowSchema", "platforms"],
      "properties": {
        "dsh": {
          "type": "object",
          "additionalProperties": false,
          "required": ["supportedRange", "verifiedVersions"],
          "properties": {
            "supportedRange": { "type": "string", "minLength": 1 },
            "verifiedVersions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "registrySchema": { "type": "integer", "const": 1 },
        "flowSchema": { "type": "integer", "const": 1 },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["windows-latest", "ubuntu-latest", "macos-latest"] }
        }
      }
    },
    "artifact": { "$ref": "#/$defs/file" },
    "matrix": { "$ref": "#/$defs/file" },
    "releaseNotes": { "$ref": "#/$defs/file" }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}

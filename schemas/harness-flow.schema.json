{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-flow.dev/schemas/harness-flow.schema.json",
  "title": "Harness Flow",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "goal", "targetUsers", "expectedOutputs", "variants", "validation", "uninstall"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "targetUsers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "expectedOutputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "variants": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "enum": ["lite", "standard", "local"] },
      "additionalProperties": { "$ref": "#/$defs/variant" }
    },
    "validation": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "uninstall": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "$defs": {
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "range", "relationship"],
      "properties": {
        "package": { "type": "string", "minLength": 1 },
        "range": { "type": "string", "minLength": 1 },
        "relationship": { "enum": ["required", "recommended", "alternative", "conflict"] },
        "alternativeGroup": { "type": "string" }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "boundaries", "skills", "plugins", "memory", "workflows", "permissionsPreset", "defaults", "platforms", "credentials"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "boundaries": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "skills": { "type": "array", "items": { "type": "string" } },
        "plugins": { "type": "array", "items": { "$ref": "#/$defs/plugin" } },
        "memory": { "type": "array", "items": { "type": "string" } },
        "workflows": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "permissionsPreset": { "type": "string", "minLength": 1 },
        "defaults": { "type": "object" },
        "platforms": { "type": "array", "minItems": 1, "items": { "enum": ["win32", "linux", "darwin"] } },
        "credentials": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-flow.dev/schemas/flow-record.schema.json",
  "title": "Harness Flow Hub Flow Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "manifest", "digest", "variants", "verification"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "version": { "type": "string", "minLength": 1 },
    "manifest": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "variants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["lite", "standard", "local"] }
    },
    "verification": { "$ref": "verification-result.schema.json" }
  }
}

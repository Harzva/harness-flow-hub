{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-flow.dev/schemas/registry-signature.schema.json",
  "title": "Harness Flow Hub Detached Registry Signature",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "algorithm", "keyId", "registryVersion", "registrySha256", "createdAt", "expiresAt", "signature"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "algorithm": { "const": "Ed25519" },
    "keyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "registryVersion": { "type": "string", "minLength": 1 },
    "registrySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "signature": { "type": "string", "minLength": 1 }
  }
}

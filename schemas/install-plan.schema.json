{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-flow.dev/schemas/install-plan.schema.json",
  "title": "Harness Flow Hub Install Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "createdAt", "expiresAt", "action", "profile", "packageName", "source", "requirements", "risk", "phases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-f0-9]{24}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "action": { "enum": ["add", "update", "remove"] },
    "profile": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$" },
    "packageName": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "spec"],
      "properties": {
        "kind": { "enum": ["npm", "tgz", "github-sha", "local-directory"] },
        "spec": { "type": "string", "minLength": 1 }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dshVersion", "platforms", "network"],
      "properties": {
        "dshVersion": { "type": "string", "minLength": 1 },
        "platforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["win32", "linux", "darwin"] } },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required"],
          "properties": {
            "required": { "type": "boolean" },
            "endpoint": { "type": "string", "format": "uri" }
          }
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycleScriptsDisabled", "permissions", "credentials", "verification", "signature"],
      "properties": {
        "lifecycleScriptsDisabled": { "const": true },
        "permissions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "credentials": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "verification": { "type": "string", "minLength": 1 },
        "signature": { "enum": ["verified", "not-applicable-trusted-fixture", "unverified"] }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["preflight", "snapshot", "staging", "install", "dump-config", "commit", "health", "rollback", "complete"] }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-flow.dev/schemas/discovery-snapshot.schema.json",
  "title": "Harness Flow Hub Discovery Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "candidates"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "topic", "npmQuery", "asOf"],
      "properties": {
        "kind": { "const": "github-topic+npm-search" },
        "topic": { "const": "dsh-plugin" },
        "npmQuery": { "type": "string", "minLength": 1 },
        "asOf": { "type": "string", "format": "date" }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "repository", "url", "stars", "license", "package"],
        "properties": {
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "spec"],
            "properties": {
              "kind": { "enum": ["github-sha", "npm"] },
              "spec": { "type": "string", "minLength": 1 },
              "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
              "integrity": { "type": "string", "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$" }
            },
            "allOf": [
              {
                "if": { "properties": { "kind": { "const": "github-sha" } }, "required": ["kind"] },
                "then": { "properties": { "commit": true }, "required": ["commit"] }
              },
              {
                "if": { "properties": { "kind": { "const": "npm" } }, "required": ["kind"] },
                "then": { "properties": { "integrity": true }, "required": ["integrity"] }
              }
            ]
          },
          "repository": { "type": ["string", "null"] },
          "url": { "type": "string", "format": "uri" },
          "stars": { "type": ["integer", "null"], "minimum": 0 },
          "license": { "type": ["string", "null"] },
          "package": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "bundlePatch", "scripts"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
              "bundlePatch": { "type": "string", "pattern": "^(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+\\.ya?ml$" },
              "scripts": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}

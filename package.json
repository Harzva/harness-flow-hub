{
  "name": "@harness-flow/dsh-flow-hub",
  "version": "0.0.2-m0",
  "description": "DSH-native Harness Flow Hub for DeepSeek Harness plugins, Agent Stacks, and recoverable Profile transactions",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-flow",
    "dsh-flow-hub",
    "dsh-hub",
    "deepseek-harness",
    "harness-flow",
    "agent-stack",
    "plugin-registry"
  ],
  "type": "module",
  "private": true,
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/bootstrap.d.ts",
      "default": "./lib/client.js"
    },
    "./bootstrap-policy": {
      "types": "./lib/types/bootstrap-policy.d.ts",
      "default": "./lib/bootstrap-policy.js"
    },
    "./compatibility": {
      "types": "./lib/types/compatibility.d.ts",
      "default": "./lib/compatibility.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/transaction.js",
    "lib/flow-resolver.js",
    "lib/bootstrap-policy.js",
    "lib/compatibility.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "compatibility/*.json",
    "registry/generated/registry.json",
    "registry/flows/*.dsh-flow.yml",
    "schemas/*.schema.json"
  ],
  "dsh": {
    "compatibility": {
      "dsh": ">=0.1.0-rc.6 <0.2.0",
      "registrySchema": 1,
      "flowSchema": 1
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc --emitDeclarationOnly",
    "check": "pnpm build && node --test tests/*.test.mjs",
    "registry:discover": "node scripts/discover-github.mjs registry/discovery/github-topic-2026-08-16.json 20 10",
    "registry:audit-candidates": "node scripts/audit-candidates.mjs registry/discovery/github-topic-2026-08-16.json registry/audits/candidates-2026-08-16.json",
    "registry:validate-inputs": "node scripts/validate-registry-inputs.mjs registry/discovery/github-topic-2026-08-16.json registry/verifications",
    "registry:generate": "node scripts/generate-registry.mjs registry/discovery/github-topic-2026-08-16.json registry/generated/registry.json",
    "registry:validate": "node scripts/validate-registry.mjs registry/generated/registry.json",
    "registry:assemble-release": "node scripts/assemble-registry-release.mjs registry/generated/registry.json",
    "registry:validate-release-candidate": "node scripts/validate-registry-release.mjs dist/registry/2026.08.16-alpha.1 --allow-unsigned",
    "registry:sign": "node scripts/sign-registry.mjs",
    "registry:verify-signature": "node scripts/verify-registry-signature.mjs",
    "registry:verify-install": "node scripts/verify-installations.mjs registry/generated/registry.json registry/verifications 10",
    "registry:verify-trusted-fixture": "node scripts/verify-trusted-fixture-lifecycle.mjs",
    "transaction:verify-lifecycle": "pnpm build && node scripts/verify-transaction-lifecycle.mjs",
    "transaction:verify-adapters": "pnpm build && node scripts/verify-transaction-adapters.mjs",
    "transaction:verify-versions": "pnpm build && node scripts/verify-transaction-version-lifecycle.mjs",
    "transaction:verify-rollback": "pnpm build && node scripts/verify-rollback-lifecycle.mjs",
    "transaction:verify-flow": "pnpm build && node scripts/verify-flow-transaction-lifecycle.mjs",
    "ui:prepare-spike": "pnpm build && node scripts/prepare-native-ui-spike.mjs",
    "ui:verify-lifecycle": "pnpm build && node scripts/verify-native-ui-lifecycle.mjs",
    "ui:verify-bootstrap-compatibility": "pnpm build && node scripts/verify-bootstrap-compatibility.mjs",
    "ui:verify-dsh-version-entry": "pnpm build && node scripts/verify-dsh-version-entry.mjs",
    "compatibility:resolve-matrix": "node scripts/resolve-dsh-ci-matrix.mjs",
    "compatibility:aggregate-matrix": "node scripts/aggregate-dsh-version-matrix.mjs",
    "hub:assemble-release": "pnpm run pack:hub && node scripts/assemble-hub-release.mjs",
    "hub:validate-release": "node scripts/validate-hub-release.mjs dist/hub/0.0.2-m0",
    "hub:verify-release-contract": "node scripts/verify-hub-release-contract.mjs",
    "site:audit": "node scripts/audit-public-site.mjs _site",
    "site:serve": "node scripts/serve-site.mjs",
    "pack:fixture": "pnpm --dir fixtures/hello-bundle pack --pack-destination ../../artifacts && pnpm --dir fixtures/hello-bundle-v2 pack --pack-destination ../../artifacts",
    "pack:hub": "pnpm build && pnpm pack --pack-destination artifacts"
  },
  "dependencies": {
    "semver": "7.8.5",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/semver": "7.8.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.25.0",
    "react": "^18.2.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.19.0"
}
